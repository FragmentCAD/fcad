{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Block Metadata Schema",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Nombre legible del bloque"
    },
    "type": {
      "type": "string",
      "enum": ["static", "parametric"],
      "description": "Tipo de bloque: estático (DXF en disco) o paramétrico (nativo)"
    },
    "ai_tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "description": "Lista de etiquetas para la IA"
    },
    "parameters": {
      "type": "object",
      "description": "Parámetros extra, por ejemplo escala"
    }
  },
  "required": ["name", "type", "ai_tags"]
}
